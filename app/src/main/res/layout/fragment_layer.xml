<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
     tools:context=".fragments.LayerFragment"
    android:background="#6F343232"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

<TextView
    android:id="@+id/purpleBg"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:background="@drawable/top_bg"

    />



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="237dp">

        <ImageView
            android:id="@+id/rainbow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:src="@drawable/rainbow"
            app:layout_constraintEnd_toEndOf="@+id/suitcase"
            app:layout_constraintStart_toStartOf="@+id/suitcase"
            app:layout_constraintTop_toTopOf="@+id/suitcase" />

        <ImageView
            android:id="@+id/suitcase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="40dp"
            android:layout_marginBottom="100dp"
            android:src="@drawable/suitcase"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="207dp"
            android:layout_height="31dp"
            android:layout_marginBottom="100dp"
            android:paddingStart="27dp"
            android:text="Leave Summary"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="120dp"
            android:paddingStart="27dp"
            android:text="Submit Leave"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="#B5FFFFFF"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mainTitle" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="148dp"

        >

        <TextView
            android:id="@+id/whiteBg"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/middle_bg"

            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="29dp"
            android:layout_marginBottom="123dp"
            android:text="Total Leave"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="#000000"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/whiteBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:layout_marginBottom="95dp"
            android:text="Period 1 Jan 2024 - 30 Dec 2024"
            app:layout_constraintBottom_toBottomOf="@+id/whiteBg"
            app:layout_constraintStart_toStartOf="@+id/textView6"
            app:layout_constraintTop_toTopOf="@+id/textView6" />

        <TextView
            android:id="@+id/border1"
            android:layout_width="160dp"
            android:layout_height="69dp"
            android:layout_marginLeft="12dp"
            android:background="@drawable/grey_bg"
            app:layout_constraintBottom_toBottomOf="@+id/whiteBg"
            app:layout_constraintEnd_toStartOf="@+id/border2"
            app:layout_constraintStart_toStartOf="@+id/whiteBg"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <TextView
            android:id="@+id/border2"
            android:layout_width="160dp"
            android:layout_height="69dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/grey_bg"
            app:layout_constraintBottom_toBottomOf="@+id/whiteBg"
            app:layout_constraintEnd_toEndOf="@+id/whiteBg"
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/green"
            app:layout_constraintBottom_toBottomOf="@+id/border1"
android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="47dp"
            app:layout_constraintStart_toStartOf="@+id/border1"
            app:layout_constraintTop_toTopOf="@+id/border1" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/purple"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="47dp"
            app:layout_constraintBottom_toBottomOf="@+id/border2"
            app:layout_constraintStart_toStartOf="@+id/border2"
            app:layout_constraintTop_toTopOf="@+id/border2" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="79dp"
            android:text="Available"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/border1"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="@+id/border1" />
        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="79dp"
            android:layout_marginTop="9dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingLeft="5dp"
            android:text="Leave Used"
            app:layout_constraintEnd_toEndOf="@+id/border2"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="@+id/border2" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:layout_margin="12dp"
            android:text="20"
            android:textSize="33dp"
            android:textColor="#101828"
            app:layout_constraintBottom_toBottomOf="@+id/border1"
            app:layout_constraintStart_toStartOf="@+id/border1"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"

            android:textSize="33dp"
            android:textColor="#101828"
            android:layout_marginTop="21dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/border2"
            app:layout_constraintStart_toStartOf="@+id/border2"
            app:layout_constraintTop_toBottomOf="@+id/textView4" />

        <com.google.android.material.tabs.TabLayout

            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="17dp"

            android:background="@drawable/middle_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/whiteBg"
            app:tabBackground="@drawable/selector1"
            app:tabTextColor="@color/selector2">

            <com.google.android.material.tabs.TabItem

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Review" />

            <com.google.android.material.tabs.TabItem

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved" />

            <com.google.android.material.tabs.TabItem

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rejected" />
        </com.google.android.material.tabs.TabLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_marginLeft="24dp"
        android:layout_height="270dp"
        android:layout_marginTop="365dp">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/VP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_marginTop="650dp"
        android:background="@color/white"
        >

        <Button
            android:id="@+id/SubmitLeaveBtn"
            android:layout_width="325dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#5B2ED4"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:text="Submit Leave"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textSize="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>








